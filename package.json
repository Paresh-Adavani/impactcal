{
  "name": "impactcal",
  "version": "2.0.0",
  "description": "ADONI TECH ImpactCal - unified selection, RFQ, quotation and approval suite (Netlify + CSV database)",
  "private": true,
  "scripts": {
    "start": "node --no-warnings tools/dev-server.js",
    "test": "node --no-warnings test/run.js",
    "verify": "node --no-warnings test/verify_catalogue.js",
